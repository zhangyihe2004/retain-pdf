# 核心运行路径
PROJECT_ROOT=/app
RUST_API_ROOT=/app/services/api
RUST_API_DATA_ROOT=/data
OUTPUT_ROOT=/data/jobs

# 容器内运行参数
PYTHON_BIN=python3
TYPST_BIN=/usr/local/bin/typst
TYPST_PACKAGE_PATH=/app/backend/typst-packages
TYPST_PACKAGE_CACHE_PATH=/data/typst-package-cache
RETAIN_PDF_FONT_PATH=/usr/local/share/fonts/source-han-serif/SourceHanSerifSC-Regular.otf
RETAIN_PDF_TITLE_BOLD_FONT_PATH=/usr/local/share/fonts/source-han-serif/SourceHanSerifSC-Bold.otf
RETAIN_PDF_TYPST_FONT_DIRS=/usr/local/share/fonts/source-han-serif
RETAIN_PDF_TYPST_FONT_FAMILY=Source Han Serif SC

# 容器内服务端口
RUST_API_BIND_HOST=0.0.0.0
RUST_API_PORT=41000
RUST_API_SIMPLE_PORT=42000

# 并发与限制
RUST_API_MAX_RUNNING_JOBS=4
RUST_API_UPLOAD_MAX_BYTES=209715200
RUST_API_UPLOAD_MAX_PAGES=300

# OCR inference services on the Linux host. Change ports to match your servers.
RETAIN_PADDLE_LOCAL_API_URL=http://host.docker.internal:41013/layout-parsing
RETAIN_PADDLE_LOCAL_API_TIMEOUT_SECONDS=7200
RETAIN_DOTS_LOCAL_API_URL=http://host.docker.internal:41010/v1/chat/completions
RETAIN_DOTS_LOCAL_MODEL=model
RETAIN_DOTS_NUM_THREAD=4
RETAIN_DOTS_LOCAL_API_TIMEOUT_SECONDS=7200
RETAIN_LOCAL_OCR_COMMAND_TIMEOUT_SECONDS=7200

# Enable title-only company detection and Flash review, like run_hymt_pdf.ps1.
# Set this URL to an empty value to disable company detection.
RETAIN_GLINER2_URL=http://host.docker.internal:41012
# DEEPSEEK_API_KEY=your-deepseek-api-key
